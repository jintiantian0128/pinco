{
  "name": "xiaohongshu_ai_pm_mcp",
  "description": "小红书AI产品经理求职内容获取MCP服务器",
  "version": "1.0.0",
  "server": {
    "command": "python",
    "args": ["xiaohongshu_mcp.py"]
  },
  "tools": [
    {
      "name": "search_xiaohongshu_content",
      "description": "搜索小红书上的AI产品经理求职相关内容",
      "examples": [
        {
          "description": "搜索AI产品经理面试经验",
          "arguments": {
            "query": "AI产品经理面试",
            "limit": 10
          }
        },
        {
          "description": "搜索AI产品经理技能要求",
          "arguments": {
            "query": "AI产品经理技能",
            "limit": 15
          }
        }
      ]
    },
    {
      "name": "get_trending_ai_pm_content",
      "description": "获取小红书热门的AI产品经理求职内容",
      "examples": [
        {
          "description": "获取10条热门内容",
          "arguments": {
            "limit": 10
          }
        }
      ]
    },
    {
      "name": "get_recent_ai_pm_content",
      "description": "获取小红书最近的AI产品经理求职内容",
      "examples": [
        {
          "description": "获取最近24小时的内容",
          "arguments": {
            "hours": 24,
            "limit": 20
          }
        },
        {
          "description": "获取最近12小时的热门内容",
          "arguments": {
            "hours": 12,
            "limit": 10
          }
        }
      ]
    },
    {
      "name": "get_ai_pm_insights",
      "description": "获取AI产品经理求职趋势分析和见解",
      "examples": [
        {
          "description": "分析AI产品经理需要的技能",
          "arguments": {
            "analysis_type": "skills",
            "limit": 10
          }
        },
        {
          "description": "分析AI产品经理薪资情况",
          "arguments": {
            "analysis_type": "salary",
            "limit": 8
          }
        },
        {
          "description": "分析AI产品经理职业发展",
          "arguments": {
            "analysis_type": "career",
            "limit": 10
          }
        },
        {
          "description": "分析AI产品经理面试经验",
          "arguments": {
            "analysis_type": "interview",
            "limit": 12
          }
        }
      ]
    }
  ],
  "keywords": [
    "AI产品经理",
    "人工智能产品经理",
    "AI PM",
    "机器学习产品经理",
    "大模型产品经理",
    "NLP产品经理",
    "计算机视觉产品经理",
    "AI产品求职",
    "AI产品经理面试",
    "AI产品经理经验",
    "AI产品经理技能",
    "AI产品经理学习",
    "AI产品经理成长",
    "产品经理转AI",
    "AI产品经理薪资",
    "AI产品经理发展"
  ],
  "update_interval": 300,
  "max_cache_size": 1000
}
