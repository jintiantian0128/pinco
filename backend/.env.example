# Pinco production environment template — never upload real secrets in a zip.

# DeepSeek uses an OpenAI-compatible API.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash

# Durable product state. Production must not use the container filesystem.
# WeChat CloudBase already exposes MYSQL_ADDRESS / USERNAME / PASSWORD.
PINCO_STATE_BACKEND=mysql
MYSQL_ADDRESS=10.0.0.1:3306
MYSQL_USERNAME=pinco_app
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_DATABASE=pinco
MYSQL_STATE_TABLE=pinco_state

# Protect expert-review and runtime-admin endpoints with a long random value.
PINCO_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# WeChat stable identity.
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_REQUEST_DOMAIN=https://your-cloudbase-domain.example.com

# Aliyun Intelligent Speech Interaction (one-sentence recognition).
ASR_PROVIDER=aliyun
ALIYUN_NLS_APP_KEY=your-nls-app-key
ALIYUN_AK_ID=your-ram-access-key-id
ALIYUN_AK_SECRET=your-ram-access-key-secret
ALIYUN_NLS_ENDPOINT=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/asr
ENABLE_LOCAL_WHISPER=false
# Only set true after DevTools + iOS + Android each pass 3 real recordings.
ASR_DEVICE_VERIFIED=false

# WeChat Pay v3. Keep all key material in CloudBase secrets/environment
# variables; never place real values in .env committed to git or in upload zip.
WECHAT_PAY_ENABLED=false
WECHAT_PAY_LIVE_VERIFIED=false
MEMBERSHIP_SALES_ENABLED=false
EXPERT_PAYMENTS_ENABLED=false
WECHAT_PAY_MCH_ID=your-direct-merchant-id
WECHAT_PAY_CERT_SERIAL_NO=your-merchant-certificate-serial-number
# Base64 of the complete PEM file, including BEGIN/END lines.
WECHAT_PAY_PRIVATE_KEY_BASE64=base64-of-merchant-private-key-pem
WECHAT_PAY_API_V3_KEY=your-exactly-32-byte-apiv3-key
# Current WeChat Pay platform public key and its PUB_KEY_ID, not the merchant key.
WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_your-platform-public-key-id
WECHAT_PAY_PUBLIC_KEY_BASE64=base64-of-wechatpay-platform-public-key-pem
WECHAT_PAY_NOTIFY_URL=https://your-cloudrun-domain.example.com/api/v1/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://your-cloudrun-domain.example.com/api/v1/payments/wechat/refund-notify
# Comma-separated Pinco user_id values for small-value live acceptance only.
WECHAT_PAY_TEST_USER_IDS=
